{
	"info": {
		"_postman_id": "admintopi-restful-api-collection",
		"name": "AdminTopi RESTful API (Production Standard)",
		"description": "Dokumentasi dan koleksi endpoint RESTful API backend manajemen produk topi berbasis Laravel dan Laravel Sanctum.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register New Staff/User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Budi Staff\",\n  \"email\": \"budi@admintopi.com\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"role\": \"staff\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Login Admin",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@admintopi.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login Staff",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"staff@admintopi.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Get Current Profile (Me)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						}
					}
				},
				{
					"name": "Logout Current Session",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["auth", "logout"]
						}
					}
				}
			]
		},
		{
			"name": "2. Categories",
			"item": [
				{
					"name": "List All Categories",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/categories",
							"host": ["{{base_url}}"],
							"path": ["categories"]
						}
					}
				},
				{
					"name": "Create Category (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Beret Hat\",\n  \"description\": \"Topi baret bergaya klasik khas Eropa.\",\n  \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories",
							"host": ["{{base_url}}"],
							"path": ["categories"]
						}
					}
				},
				{
					"name": "Get Category Detail",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/categories/1",
							"host": ["{{base_url}}"],
							"path": ["categories", "1"]
						}
					}
				},
				{
					"name": "Update Category (Admin Only)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Snapback Streetwear\",\n  \"description\": \"Topi snapback dengan lidah datar premium.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories/1",
							"host": ["{{base_url}}"],
							"path": ["categories", "1"]
						}
					}
				},
				{
					"name": "Delete Category (Admin Only)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/categories/1",
							"host": ["{{base_url}}"],
							"path": ["categories", "1"]
						}
					}
				}
			]
		},
		{
			"name": "3. Products (Topi)",
			"item": [
				{
					"name": "List Products (Search & Filter)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/products?search=Snapback&in_stock=true&min_price=100000&max_price=200000&sort_by=price&sort_order=asc&per_page=10",
							"host": ["{{base_url}}"],
							"path": ["products"],
							"query": [
								{ "key": "search", "value": "Snapback" },
								{ "key": "in_stock", "value": "true" },
								{ "key": "min_price", "value": "100000" },
								{ "key": "max_price", "value": "200000" },
								{ "key": "sort_by", "value": "price" },
								{ "key": "sort_order", "value": "asc" },
								{ "key": "per_page", "value": "10" }
							]
						}
					}
				},
				{
					"name": "Create Product (Multipart Form-Data with File Upload)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "category_id", "value": "1", "type": "text" },
								{ "key": "name", "value": "Vintage Snapback Special Edition", "type": "text" },
								{ "key": "sku", "value": "TOPI-EDT-099", "type": "text" },
								{ "key": "description", "value": "Edisi terbatas snapback dengan material katun tebal impor.", "type": "text" },
								{ "key": "price", "value": "199000", "type": "text" },
								{ "key": "stock", "value": "20", "type": "text" },
								{ "key": "material", "value": "Heavy Cotton Twill", "type": "text" },
								{ "key": "status", "value": "published", "type": "text" },
								{ "key": "image", "type": "file", "src": "" }
							]
						},
						"url": {
							"raw": "{{base_url}}/products",
							"host": ["{{base_url}}"],
							"path": ["products"]
						}
					}
				},
				{
					"name": "Get Product Detail",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/products/1",
							"host": ["{{base_url}}"],
							"path": ["products", "1"]
						}
					}
				},
				{
					"name": "Update Product Data",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Urban Street Flat Snapback Black v2\",\n  \"price\": 155000,\n  \"material\": \"Premium Heavyweight Cotton\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/products/1",
							"host": ["{{base_url}}"],
							"path": ["products", "1"]
						}
					}
				},
				{
					"name": "Upload Product Image",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "image", "type": "file", "src": "" }
							]
						},
						"url": {
							"raw": "{{base_url}}/products/1/upload-image",
							"host": ["{{base_url}}"],
							"path": ["products", "1", "upload-image"]
						}
					}
				},
				{
					"name": "Adjust Stock (Safe Concurrency Mutation)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"in\",\n  \"quantity\": 25,\n  \"notes\": \"Restok produk batch November\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/products/1/adjust-stock",
							"host": ["{{base_url}}"],
							"path": ["products", "1", "adjust-stock"]
						}
					}
				},
				{
					"name": "Get Product Stock Movement Audit Trail",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/products/1/stock-movements",
							"host": ["{{base_url}}"],
							"path": ["products", "1", "stock-movements"]
						}
					}
				},
				{
					"name": "Delete Product (Soft Delete)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/products/1",
							"host": ["{{base_url}}"],
							"path": ["products", "1"]
						}
					}
				}
			]
		}
	]
}
